<button class="theme-toggle" type="button" aria-label="切换至暗黑模式" aria-pressed="false" hidden>
  <svg class="moon-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13.4A8.5 8.5 0 0 1 10.6 3.5a8.5 8.5 0 1 0 9.9 9.9Z"/></svg>
  <svg class="sun-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
</button>
<script>
const root = document.documentElement;
const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
const sync = () => {
  const dark = root.dataset.theme === 'dark';
  buttons.forEach(button => {
    button.hidden = false;
    button.setAttribute('aria-label', dark ? '切换至浅色模式' : '切换至暗黑模式');
    button.setAttribute('aria-pressed', String(dark));
  });
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#20211f' : '#f6f3eb');
};
buttons.forEach(button => button.addEventListener('click', () => {
  root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
  try { localStorage.setItem('unehao-theme', root.dataset.theme); } catch {}
  sync();
}));
sync();
const preference = matchMedia('(prefers-color-scheme: dark)');
preference.addEventListener('change', () => {
  let saved; try { saved = localStorage.getItem('unehao-theme'); } catch {}
  if (saved !== 'dark' && saved !== 'light') {
    root.dataset.theme = preference.matches ? 'dark' : 'light'; sync();
  }
});
</script>
