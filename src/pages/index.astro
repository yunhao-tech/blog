---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import VisitorFooter from '../components/VisitorFooter.astro';
---
<Layout>
  <main id="main" class="index-shell">
    <SiteHeader />
    <section class="profile" aria-labelledby="intro-title">
      <p class="profile-kicker">ABOUT ME</p>
      <h1 id="intro-title">你好，我是 Unehao。</h1>
      <div class="profile-copy">
        <p>这里是我的个人博客。</p>
        <p>写一些技术，也记录阅读和日常里的思考。</p>
      </div>
      <nav class="profile-links" aria-label="个人主页">
        <a class="profile-link" href="https://www.zhihu.com/people/chen-yun-hao-89" target="_blank" rel="noopener noreferrer" aria-label="知乎个人主页（新窗口打开）">知乎 <span aria-hidden="true">↗</span></a>
        <a class="profile-link" href="https://juejin.cn/user/4263257823785808" target="_blank" rel="noopener noreferrer" aria-label="掘金个人主页（新窗口打开）">掘金 <span aria-hidden="true">↗</span></a>
      </nav>
    </section>
    <VisitorFooter mode="site" />
  </main>
</Layout>
